# Copy to .env and fill in real values. Never commit .env.

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/restaurant_ai
DATABASE_USERNAME=restaurant_ai
DATABASE_PASSWORD=change_me

# JWT
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# WhatsApp Business Cloud API
# MOCK_WHATSAPP=true means outbound messages are logged, not actually sent.
# This lets us fully test the AI -> tool -> database -> Claude loop first.
MOCK_WHATSAPP=true
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# From Meta App Dashboard > Settings > Basic > App Secret. Required whenever
# MOCK_WHATSAPP=false - used to verify inbound webhook signatures, NOT the
# same value as the access token above.
WHATSAPP_APP_SECRET=

# Gemini (free-tier friendly)
# MOCK_GEMINI=false -> real Gemini API calls, as requested for MVP.
MOCK_GEMINI=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Single-restaurant MVP: the one restaurant row's id (seeded by migration/seed script)
DEFAULT_RESTAURANT_ID=00000000-0000-0000-0000-000000000001
